# ===== ESTADOS-GADSO — Configuracion de ejemplo =====
# Copiar a .env y completar los valores. NO versionar .env.

# --- Portal ---
SUCAMEC_URL_LOGIN=https://www.sucamec.gob.pe/sel/faces/login.xhtml?faces-redirect=true
SUCAMEC_CONSULTAS_MODULE=mis_vigilantes
SUCAMEC_HEADLESS=0
SUCAMEC_HOLD_BROWSER_OPEN=0

# --- Credenciales JV (J&V Resguardo) ---
SUCAMEC_TIPO_DOC=RUC
SUCAMEC_NUMERO_DOCUMENTO=
SUCAMEC_USUARIO_SEL=
SUCAMEC_CLAVE_SEL=

# --- Credenciales SELVA ---
SUCAMEC_SELVA_TIPO_DOC=RUC
SUCAMEC_SELVA_NUMERO_DOCUMENTO=
SUCAMEC_SELVA_USUARIO_SEL=
SUCAMEC_SELVA_CLAVE_SEL=

# --- Login / CAPTCHA (OCR) ---
SUCAMEC_OCR_MAX_INTENTOS=4
SUCAMEC_CAPTCHA_SOLVE_TIMEOUT_MS=120000
SUCAMEC_LOGIN_CAPTCHA_RETRIES=3
SUCAMEC_FORCE_FIRST_CAPTCHA=
SUCAMEC_LOGIN_VALIDATION_TIMEOUT_MS=12000

# --- Recuperacion ante "Error del servidor" ---
SUCAMEC_SERVER_ERROR_RETRIES=3
SUCAMEC_SERVER_ERROR_WAIT_MS=4000
SUCAMEC_SERVER_ERROR_MAX_FAILED_SESSIONS=0

# --- Entrada / salida ---
SUCAMEC_INPUT_EXCEL=
SUCAMEC_MAX_RECORDS=0
LOG_DIR=logs
SCREENSHOT_DIR=screenshots

# --- Workers (1-2 recomendado con SUCAMEC inestable) ---
SCHEDULED_MULTIWORKER=0
SCHEDULED_WORKERS=1
CARNET_WORKER_MAX_ROWS=0
